{
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "module": "ESNext",
    "target": "esnext",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "lib": ["ESNext", "dom"],
    "paths": {
      "src": ["src/*"]
    }
  },
  "include": ["src/**/*", "src/*", "**/*.ts"],
  "exclude": ["node_modules/*"]
}
